{
    "name": "tauri-discord-bot",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/index.ts",
        "start": "node src/index.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": "24.x"
    },
    "packageManager": "pnpm@11.21.0",
    "dependencies": {
        "discord.js": "14.26.5",
        "express": "5.2.1",
        "jellycommands": "1.0.0-next.45"
    },
    "devDependencies": {
        "@types/express": "5.0.6",
        "@types/node": "24.13.3",
        "prettier": "3.2.5",
        "typescript": "6.0.3"
    }
}
