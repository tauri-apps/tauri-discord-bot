{
    "name": "tauri-discord-bot",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/index.ts",
        "start": "node src/index.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24.x",
        "pnpm": "11.x"
    },
    "dependencies": {
        "discord.js": "14.26.5",
        "dotenv": "16.4.5",
        "express": "4.19.2",
        "jellycommands": "1.0.0-next.45",
        "ts-node": "10.9.2",
        "tsm": "2.3.0",
        "unfurl.js": "6.3.1",
        "url-regex-safe": "3.0.0"
    },
    "devDependencies": {
        "@types/express": "4.17.25",
        "@types/node": "24.13.3",
        "@types/url-regex-safe": "1.0.2",
        "nodemon": "3.1.1",
        "prettier": "3.2.5",
        "typescript": "6.0.3"
    }
}
